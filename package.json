{
  "name": "MindOS",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{vue,js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss,json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@nuxtjs/supabase": "2.0.9",
    "nuxt": "4.4.8",
    "vue": "3.5.35",
    "vue-router": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nuxt/eslint": "^1.16.0",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.8.0",
    "autoprefixer": "10.5.0",
    "eslint": "10.5.0",
    "eslint-plugin-vue": "10.9.2",
    "globals": "17.6.0",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "postcss-custom-media": "12.0.1",
    "postcss-nesting": "14.0.0",
    "prettier": "3.8.4",
    "typescript-eslint": "8.61.1"
  }
}
